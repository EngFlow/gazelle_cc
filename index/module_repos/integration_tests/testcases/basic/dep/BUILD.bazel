# Re-export a private `cc_library` from another package.
alias(
    name = "hidden",
    actual = "//hidden",
    visibility = ["//visibility:public"],
)

# Two aliases for one public target. The repository-named one wins.
alias(
    name = "dep",
    actual = "//core:core",
    visibility = ["//visibility:public"],
)

alias(
    name = "core_library",
    actual = "//core:core",
    visibility = ["//visibility:public"],
)

# Re-exports a private `cc_proto_library`.
alias(
    name = "shared_cc_proto",
    actual = "//hidden:shared_cc_proto",
    visibility = ["//visibility:public"],
)
